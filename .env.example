# ===========================================
# GLOBAL PULSE - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git!

# -------------------------------------------
# Supabase (Required)
# -------------------------------------------
# Get these from: https://app.supabase.com > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -------------------------------------------
# OneSignal Push Notifications (Required)
# -------------------------------------------
# Get these from: https://onesignal.com > App Settings > Keys & IDs
NEXT_PUBLIC_ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key

# -------------------------------------------
# Security Secrets (Required)
# -------------------------------------------
# Generate with: openssl rand -hex 32
CRON_SECRET=generate-a-random-secret-min-32-chars
ADMIN_SECRET=generate-another-random-secret-min-32-chars
SESSION_SECRET=generate-a-third-random-secret-min-32-chars

# -------------------------------------------
# Email (optional - required for recovery in production)
# -------------------------------------------
# RESEND_API_KEY=re_xxxxxxxxx
# EMAIL_FROM=Global Pulse <noreply@yourdomain.com>

# -------------------------------------------
# Mapbox (Optional - for world pulse map)
# -------------------------------------------
# Get your token at: https://console.mapbox.com/account/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token

# -------------------------------------------
# App Configuration (Optional)
# -------------------------------------------
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# -------------------------------------------
# Rate Limiting (Optional - defaults shown)
# -------------------------------------------
# RATE_LIMIT_PULSE=10
# RATE_LIMIT_WINDOW_SECONDS=60
